# =========================
# Dependencies
# =========================
node_modules/
.pnpm-store/
.npm/

# Yarn Berry
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# =========================
# Frontend build outputs
# =========================
dist/
build/
.out/
.next/
.nuxt/
.svelte-kit/
.vite/
coverage/

# =========================
# Tauri / Rust
# =========================
target/
src-tauri/target/
src-tauri/data/
**/*.rs.bk

# =========================
# Logs
# =========================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# Environment files
# =========================
.env
.env.*
!.env.example

# =========================
# Editor / IDE
# =========================
.vscode/
!.vscode/extensions.json
.idea/

# Agent Teams Lite local registry
.atl/

# Engram persistent memory (local only)
.engram/

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db

# =========================
# Android signing secrets
# These are intentionally excluded from the repo. If a keystore file is
# already tracked, gitignore does not untrack it; it only hides untracked
# copies from `git status`.
# =========================
src-tauri/gen/android/keystore.properties
*.jks
*.keystore

# =========================
# Android generated build outputs
# Tauri/Gradle regenerate these during mobile builds. Do not ignore source
# files under src-tauri/gen/android/app/src/main/java/.
# =========================
src-tauri/gen/android/.gradle/
src-tauri/gen/android/**/build/
src-tauri/gen/android/app/src/main/assets/
src-tauri/gen/android/local.properties

# =========================
# Local code intelligence indexes
# =========================
.codegraph/

# =========================
# SDD artifacts (openspec)
# =========================
openspec/

# =========================
# Player photos
# Newly downloaded photo assets we are not committing. Photos already tracked
# stay tracked (git ignore does not untrack); this only stops new ones from
# showing up as untracked clutter.
# =========================
public/player-photos/
